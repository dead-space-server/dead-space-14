cmd-showmarkers-desc = Toggles visibility of markers such as spawn points.
cmd-showmarkers-help = Usage: {$command}

cmd-showsubfloor-desc = Shows entities below the floor. No argument toggles every layer. An argument toggles one: cable, atmos, or disposal.
cmd-showsubfloor-help = Usage: {$command} [cable|atmos|disposal|all]

cmd-notify-desc = Send a notify client side.
cmd-notify-help = Usage: {$command} <message>
