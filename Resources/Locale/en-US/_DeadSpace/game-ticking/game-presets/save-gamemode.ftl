save-gamemode-deathmatch-title = Save: Deathmatch
save-gamemode-deathmatch-description = Wreck the station. At round end the map will be saved and an extended save mode will automatically start on it.

save-gamemode-extended-title = Save: Extended
save-gamemode-extended-description = A calm round on the map saved after the deathmatch. At round end the save file will be deleted.

save-gamemode-permap-title = Save: Round Inheritance
save-gamemode-permap-description = Every map has its own save folder. The first round on a map starts fresh and saves at the end; later rounds load from that same folder.
