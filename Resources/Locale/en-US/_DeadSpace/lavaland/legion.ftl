lavaland-storm-staff-pacified = You don't want to harm anyone.
lavaland-storm-staff-empty = The staff needs to recharge!
lavaland-storm-staff-invalid = You can't call a bolt here.
lavaland-storm-staff-already-targeted = A bolt is already coming here!
lavaland-storm-staff-no-storm = There is nothing to dispel here.
lavaland-storm-staff-dispel-start = You hold the staff up to the sky...
lavaland-storm-staff-dispelled = { CAPITALIZE(THE($user)) } holds the staff skyward and the storm fades!

lavaland-stabilizer-invalid = The serum only works on a legion soul.
lavaland-stabilizer-already = This soul is already stabilized.
lavaland-stabilizer-success = The legion soul is stabilized and will no longer fade.
lavaland-stabilizer-examine-stable = [color=lightblue]The soul is stabilized and will not fade.[/color]
lavaland-stabilizer-examine-decaying = [color=orange]The soul is unstable and will fade soon. A stabilizing serum would prevent that.[/color]

lavaland-lava-staff-point = { CAPITALIZE(THE($user)) } points the staff of lava at the ground!
lavaland-lava-staff-created = The ground under { THE($user) }'s staff turns into lava!
lavaland-lava-staff-reset = { CAPITALIZE(THE($user)) } cools the lava back into basalt.
lavaland-lava-staff-blocked = Something is in the way.
lavaland-saw-bleed-burst = Blood bursts out of { THE($target) }!

lavaland-cain-abel-mode-launch = Throw mode: dash to the mark.
lavaland-cain-abel-mode-crystals = Throw mode: ring of crystals.
lavaland-cain-abel-not-ready = The dagger has not returned yet.

lavaland-soulscythe-possessed = A soul inhabits the scythe.
lavaland-soulscythe-dormant = The scythe is dormant. Use it in hand to awaken it.
lavaland-soulscythe-blood = Blood: { $blood }.
lavaland-soulscythe-awakening = You hold the scythe up... Wait for a soul to inhabit it.
lavaland-soulscythe-glows = The scythe begins to glow!
lavaland-soulscythe-role-name = Soulscythe
