ent-GasTemperatureValveAlt1 = thermal valve
    .desc = A valve that lets gas through only at the right temperature. Open by default while the temperature is below or above the set point.
ent-GasTemperatureValveAlt2 = { ent-GasTemperatureValveAlt1 }
    .desc = { ent-GasTemperatureValveAlt1.desc }
ent-GasTemperaturePumpAlt1 = thermal pump
    .desc = Pumps heat from one side to the other, in one direction. Requires power.
ent-GasTemperaturePumpAlt2 = { ent-GasTemperaturePumpAlt1 }
    .desc = { ent-GasTemperaturePumpAlt1.desc }
