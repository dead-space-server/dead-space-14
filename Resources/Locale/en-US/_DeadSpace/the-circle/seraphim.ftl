seraphim-mend-invalid = Only a living ally can be stitched.
seraphim-mend-start = You start stitching { $target }'s flesh.
seraphim-mend-done = { $target }'s flesh knits together and the organs are renewed.
seraphim-bond-invalid = You can't bond with that.
seraphim-bond-start = Necromorph fibres bind you to { $target }.
seraphim-bond-cut = You tear the fibres apart.
seraphim-bond-snapped = The fibres stretch and snap.

antag-gear-selector-seraphim-mend-name = Flesh stitching
antag-gear-selector-seraphim-mend-description = In five seconds you knit an ally's fractures and tears and renew damaged organs. You can do it again a minute later.
antag-gear-selector-seraphim-bond-name = Necromorph fibres
antag-gear-selector-seraphim-bond-description = You bind yourself to an ally. Healing one heals both, the ally's overdoses are split with you, and both slowly mend fractures and bleeding.
