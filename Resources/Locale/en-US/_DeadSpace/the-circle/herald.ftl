antag-gear-selector-herald-dash-name = Dash
antag-gear-selector-herald-dash-description = The herald's usual dash through the crowd. Getting hit no longer holds it back: you can dash even under fire.
antag-gear-selector-herald-teleport-name = Shift
antag-gear-selector-herald-teleport-description = An instant jump to any point in sight, even behind an enemy's back. Every hit you take holds it back for three seconds.
