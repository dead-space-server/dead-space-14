ent-BluespaceMiner = блюспейс-майнер
    .desc = Машина неведомой конструкции, добывающая различные материалы прямо из блюспейса. Иссушает блюспейсом сыпучие ресурсы вокруг себя. Требует охлаждённую среду (20–80 K) и давление 100–150 кПа, при работе выделяет горячий углекислый газ.
ent-BluespaceMinerMachineCircuitboard = плата блюспейс-майнера
    .desc = Плата машины, добывающей материалы из блюспейса.
bluespace-miner-examine-ok = Все условия работы соблюдены.
bluespace-miner-examine-temp-low = [color=deepskyblue]Температура слишком низкая.[/color]
bluespace-miner-examine-temp-high = [color=orange]Температура слишком высокая.[/color]
bluespace-miner-examine-pressure-low = [color=deepskyblue]Давление слишком низкое.[/color]
bluespace-miner-examine-pressure-high = [color=orange]Давление слишком высокое.[/color]
bluespace-miner-examine-unpowered = [color=red]Нет питания.[/color]
