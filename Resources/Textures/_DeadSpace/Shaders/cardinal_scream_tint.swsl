// The world seen through the cardinal's scream: everything recoloured in the scream's colour, strongest at the edges.

light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform highp vec4 tint;
uniform highp float strength;

void fragment()
{
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    highp vec3 picture = zTextureSpec(SCREEN_TEXTURE, uv).rgb;
    highp float light = zGrayscale(picture);
    highp vec3 coloured = tint.rgb * (light * 1.4 + 0.06);
    highp vec2 edge = uv - 0.5;
    highp float vignette = clamp(dot(edge, edge) * 2.5, 0.0, 1.0);
    highp float amount = strength * (0.6 + 0.4 * vignette);
    COLOR = vec4(mix(picture, coloured, amount), 1.0);
}
