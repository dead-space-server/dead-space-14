// Мёртвый Космос, Licensed under custom terms with restrictions on public hosting and commercial use, full text: https://raw.githubusercontent.com/dead-space-server/space-station-14-fobos/master/LICENSE.TXT
// The cardinal's scream, as a roar you can see: a punch of the lens at the first instant, then broad soft ripples
// pouring out of the mouth one after another, the picture smeared outwards with them and recoloured in the scream's
// colour, and thin streaks of sound flying off at random angles.

light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform highp vec2 renderScale;
uniform lowp int count;

// Up to four screams at once; the overlay fills these.
uniform highp vec2[4] centers;
uniform highp float[4] radii;
uniform highp float[4] times;
uniform highp float[4] strengths;
uniform highp vec4[4] colors;

const highp float TAU = 6.2831853;
const highp float SPACING = 1.7;   // tiles between ripples
const highp float SPEED = 5.5;     // ripples leaving the mouth each second
const highp float BINS = 72.0;     // angular slots a streak may fly along

highp float hash(highp vec2 p)
{
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment()
{
    highp vec2 coords = FRAGCOORD.xy;
    highp vec2 offset = vec2(0.0);
    highp vec2 smear = vec2(0.0);
    highp vec3 glow = vec3(0.0);
    highp vec3 wash = vec3(0.0);
    highp float tint = 0.0;
    highp float washAmount = 0.0;

    for (int i = 0; i < 4 && i < count; i++)
    {
        highp vec2 deltaPx = coords - centers[i];
        highp vec2 delta = deltaPx / renderScale;
        highp float d = length(delta) / 32.0;
        if (d > 0.001)
        {
            highp vec2 dir = delta / (d * 32.0);
            highp float t = times[i];
            highp float s = strengths[i];
            highp float reach = radii[i];
            highp float inside = 1.0 - smoothstep(reach * 0.75, reach, d);

            // The lens punch of the first instant: the middle swells towards the viewer.
            highp float punch = s * max(0.0, 1.0 - t / 0.28);
            offset -= deltaPx * punch * 0.22 * (1.0 - smoothstep(0.0, reach, d));

            // Broad ripples pouring outwards.
            highp float phase = d / SPACING - t * SPEED;
            highp float wave = 0.5 + 0.5 * sin(phase * TAU);
            highp float ridge = wave * wave * wave;
            highp float level = inside * s;
            offset += dir * cos(phase * TAU) * level * 5.0 * renderScale;
            smear += dir * level * (3.0 + 6.0 * ridge) * renderScale;
            glow += colors[i].rgb * ridge * level * 0.55;
            tint += ridge * level;
            wash += colors[i].rgb * level;
            washAmount += level;

            // Thin streaks flying off along random angles.
            highp float angle = atan(delta.y, delta.x);
            highp float slot = (angle + 3.14159265) / TAU * BINS;
            highp float bin = floor(slot);
            highp float beat = floor(t * 9.0);
            highp float roll = hash(vec2(bin + float(i) * 101.0, beat));
            if (roll > 0.82)
            {
                highp float along = fract(t * 9.0);
                highp float head = (0.15 + along * 1.1) * reach;
                highp float lengthTiles = 0.9 + roll * 1.2;
                highp float thin = 0.035 * (2.5 / max(d, 0.6));
                highp float across = abs(fract(slot) - 0.5);
                highp float onLine = 1.0 - smoothstep(thin * 0.5, thin, across);
                highp float onSpan = smoothstep(head - lengthTiles, head - lengthTiles * 0.3, d) * (1.0 - smoothstep(head - 0.1, head, d));
                highp float streak = onLine * onSpan * s * (1.0 - along * 0.6);
                glow += mix(colors[i].rgb, vec3(1.0), 0.5) * streak * 0.9;
                tint += streak * 0.6;
            }
        }
    }

    // Smear the picture outwards along the ripples.
    highp vec2 base = coords + offset;
    highp vec3 picture = vec3(0.0);
    for (int k = 0; k < 6; k++)
    {
        picture += zTextureSpec(SCREEN_TEXTURE, (base - smear * (float(k) / 5.0)) * SCREEN_PIXEL_SIZE).rgb;
    }
    picture /= 6.0;

    // Everything the scream fills turns its colour, light by light.
    washAmount = clamp(washAmount, 0.0, 1.0);
    highp vec3 washColour = washAmount > 0.0 ? wash / max(washAmount, 0.001) : vec3(0.0);
    highp vec3 recoloured = washColour * (zGrayscale(picture) * 1.5 + 0.05);
    highp vec3 col = mix(picture, recoloured, washAmount * 0.75);

    tint = clamp(tint, 0.0, 1.0);
    col = col + glow * (0.6 + 0.4 * tint);
    COLOR = vec4(col, 1.0);
}
