<Control xmlns="https://spacestation14.io"
         MinHeight="100">
    <PanelContainer StyleClasses="DeadSpaceListItem"/> <!-- DS14 -->
    <BoxContainer Orientation="Vertical">

        <!-- Title -->
        <BoxContainer Orientation="Vertical"> <!-- DS14 -->
            <RichTextLabel Name="TitleLabel" Margin="12 6 6 6" />
            <PanelContainer StyleClasses="DeadSpaceAccentDim" SetHeight="1" /> <!-- DS14 -->
        </BoxContainer>

        <!-- Description -->
        <RichTextLabel Name="DescriptionLabel" StyleClasses="LabelLight" Margin="12 4 12 8" VerticalExpand="True"/>

        <!-- Footer -->
        <BoxContainer Orientation="Vertical"> <!-- DS14 -->
            <PanelContainer StyleClasses="DeadSpaceAccentDim" SetHeight="1" /> <!-- DS14 -->
            <BoxContainer>
                <Label StyleClasses="LabelSmall DeadSpaceSubtitle" Name="TypeLabel" Margin="14 6 6 6" /> <!-- DS14 -->
                <Button Name="LinkButton" Text="{Loc feedbackpopup-control-button-text}" MinWidth="80"
                        Margin="8 6 14 6" HorizontalExpand="True" HorizontalAlignment="Right" />
            </BoxContainer>
        </BoxContainer>

    </BoxContainer>
</Control>
