<!-- DS14-start: department-based access editor. -->
<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               MinSize="700 400" SetSize="800 460">
    <BoxContainer Orientation="Vertical" SeparationOverride="12">
        <GridContainer Columns="2" HorizontalExpand="True" HSeparationOverride="12">
            <PanelContainer StyleClasses="DeadSpaceSurfaceFlat" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="6">
                    <BoxContainer>
                        <Label Text="{Loc 'id-card-console-window-authorization-card'}" StyleClasses="DeadSpaceSectionTitle" HorizontalExpand="True" />
                        <Button Name="PrivilegedIdButton" Access="Public" />
                    </BoxContainer>
                    <RichTextLabel Name="PrivilegedIdLabel" StyleClasses="DeadSpaceSectionTitle" HorizontalExpand="True" />
                    <Label Name="PrivilegedIdJobLabel" StyleClasses="DeadSpaceSubtitle" ClipText="True" />
                </BoxContainer>
            </PanelContainer>
            <PanelContainer StyleClasses="DeadSpaceSurfaceFlat" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="6">
                    <BoxContainer>
                        <Label Text="{Loc 'id-card-console-window-employee-card'}" StyleClasses="DeadSpaceSectionTitle" HorizontalExpand="True" />
                        <Button Name="TargetIdButton" Access="Public" />
                    </BoxContainer>
                    <RichTextLabel Name="TargetIdLabel" StyleClasses="DeadSpaceSectionTitle" HorizontalExpand="True" />
                    <Label Name="TargetIdJobLabel" StyleClasses="DeadSpaceSubtitle" ClipText="True" />
                </BoxContainer>
            </PanelContainer>
        </GridContainer>

        <GridContainer Columns="3" HSeparationOverride="8" VSeparationOverride="4">
            <Label Name="FullNameLabel" Text="{Loc 'id-card-console-window-full-name-label'}" />
            <LineEdit Name="FullNameLineEdit" HorizontalExpand="True" />
            <Button Name="FullNameSaveButton" Text="{Loc 'id-card-console-window-save-button'}" Disabled="True" />
            <Label Name="JobTitleLabel" Text="{Loc 'id-card-console-window-job-title-label'}" />
            <LineEdit Name="JobTitleLineEdit" HorizontalExpand="True" />
            <Button Name="JobTitleSaveButton" Text="{Loc 'id-card-console-window-save-button'}" Disabled="True" />
        </GridContainer>

        <BoxContainer SeparationOverride="8">
            <Label Text="{Loc 'id-card-console-window-preset-label'}" />
            <OptionButton Name="JobPresetOptionButton" HorizontalExpand="True" MaxWidth="300" RectClipContent="True" Filterable="True" StyleClasses="DeadSpaceFormField" />
            <Button Name="BasicAccessButton" Access="Public" Text="{Loc 'id-card-console-window-basic-access'}" />
            <Button Name="ExtendedAccessButton" Access="Public" Text="{Loc 'id-card-console-window-extended-access'}" />
        </BoxContainer>

        <Control Name="AccessLevelControlContainer" HorizontalExpand="True" VerticalExpand="True" />

        <BoxContainer SeparationOverride="6">
            <Button Name="SelectAllButton" Text="{Loc 'id-card-console-window-grant-category'}" />
            <Button Name="DeselectAllButton" Text="{Loc 'id-card-console-window-revoke-category'}" />
            <Control HorizontalExpand="True" />
            <Button Name="CrewManifestButton" Access="Public" Text="{Loc 'crew-manifest-button-label'}" />
            <controls:ConfirmButton Name="DismissButton" Access="Public" Visible="False"
                                    Text="{Loc 'personnel-dismissal-button'}"
                                    ConfirmationText="{Loc 'personnel-dismissal-confirm'}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
<!-- DS14-end -->
