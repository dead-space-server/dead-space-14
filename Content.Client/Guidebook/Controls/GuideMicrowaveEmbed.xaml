<PanelContainer xmlns="https://spacestation14.io"
              Margin="5 5 5 5"
              StyleClasses="DeadSpaceSurface"> <!-- DS14 -->

    <BoxContainer Orientation="Vertical">
        <PanelContainer HorizontalExpand="True" StyleClasses="DeadSpaceSectionHeader"> <!-- DS14 -->
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                <BoxContainer Name="IconContainer"/>
                <RichTextLabel Name="ResultName"/>
            </BoxContainer>
        </PanelContainer>

        <GridContainer Name="MicrowaveDetails" Columns="2" Margin="10"> <!-- DS14 -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Text="{Loc 'guidebook-microwave-ingredients-header'}"/>
                <GridContainer Columns="3" Name="IngredientsGrid"/>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Text="{Loc 'guidebook-microwave-cook-time-header'}"/>
                <RichTextLabel Name="CookTimeLabel"/>
            </BoxContainer>
        </GridContainer>

        <!-- DS14-start -->
        <BoxContainer Name="ReactionContainer"
                      Orientation="Vertical"
                      HorizontalExpand="True"
                      Visible="False"
                      Margin="10 5 10 0"/>
        <!-- DS14-end -->

        <BoxContainer Margin="10">
            <RichTextLabel Name="ResultDescription" HorizontalAlignment="Left"/>
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
