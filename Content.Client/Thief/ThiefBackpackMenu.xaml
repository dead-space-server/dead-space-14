<controls:FancyWindow xmlns="https://spacestation14.io"
						xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
						MinSize="700 700">
	<BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
		<!-- First Informational panel -->
		<Label Name="Description" Margin="5 5"/>
		<!-- DS14-start -->
		<controls:HLine StyleClasses="LowDivider" Thickness="2" Margin="0 5"/>
		<!-- DS14-end -->
		<Label Name="SelectedSets" Text="{Loc 'thief-backpack-window-selected'}" Margin="5 5"/>

		<!-- Second sets panel -->
		<!-- DS14-start -->
		<PanelContainer Margin="5 5" StyleClasses="BackgroundDark">
			<!-- DS14-end -->
			<ScrollContainer
					HScrollEnabled="False"
					MinSize="0 600"
					SizeFlagsStretchRatio="2"
					VerticalExpand="True">
				<!-- DS14-start -->
				<BoxContainer Name="SetsGrid" Orientation="Vertical" MinSize="460 200"
						Margin="8" SeparationOverride="10">
				<!-- DS14-end -->
					<!-- Sets is filled by code -->

				</BoxContainer>
			</ScrollContainer>
		</PanelContainer>
		<!-- Third approve button panel -->
		<PanelContainer Margin="10">
			<Button Name="ApproveButton"
					Text="{Loc 'thief-backpack-window-approve-button'}"
					Margin="0 5"
					Access="Public"
					HorizontalAlignment ="Right"
					StyleClasses="OpenRight"/>
		</PanelContainer>
	</BoxContainer>
</controls:FancyWindow>
