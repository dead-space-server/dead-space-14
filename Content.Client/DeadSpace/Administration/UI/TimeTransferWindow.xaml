<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'time-transfer-window-title'}"
                      MinSize="520 560"
                      SetSize="520 640">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'time-transfer-ckey-label'}" />
            <LineEdit Name="CkeyLine"
                      HorizontalExpand="True"
                      PlaceHolder="{Loc 'time-transfer-ckey-placeholder'}" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'time-transfer-overall-label'}" HorizontalExpand="True" />
            <LineEdit Name="OverallLine"
                      MinSize="90 0"
                      PlaceHolder="0" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <CheckBox Name="GroupCheck"
                      Text="{Loc 'time-transfer-group-label'}"
                      HorizontalExpand="True" />
            <LineEdit Name="GroupLine"
                      MinSize="90 0"
                      PlaceHolder="0"
                      Visible="False" />
        </BoxContainer>

        <Label Text="{Loc 'time-transfer-roles-label'}" />

        <LineEdit Name="SearchLine"
                  HorizontalExpand="True"
                  PlaceHolder="{Loc 'time-transfer-search-placeholder'}" />

        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="RolesContainer"
                              Orientation="Vertical"
                              SeparationOverride="2"
                              Margin="6" />
            </ScrollContainer>
        </PanelContainer>

        <Label Name="StatusLabel" Visible="False" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="AddButton" Text="{Loc 'time-transfer-add'}" HorizontalExpand="True" />
            <Button Name="SetButton" Text="{Loc 'time-transfer-set'}" HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
