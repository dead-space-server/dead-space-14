<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:hologram="clr-namespace:Content.Client.DeadSpace.UserInterface.Hologram.Vending"
    MinSize="560 420"
    SetSize="900 600">
    <BoxContainer Orientation="Vertical" Margin="4">
        <!-- Goods on the left, code display and keypad on the right. The grid takes whatever width is left
             and drops columns when the window narrows; the side column has a fixed width. -->
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="10">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
                <LineEdit Name="SearchBar"
                          PlaceHolder="{Loc 'vending-machine-keypad-search'}"
                          HorizontalExpand="True" />
                <PanelContainer Name="SpiralPanel" VerticalExpand="True">
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True" Margin="4">
                        <BoxContainer Orientation="Vertical">
                            <hologram:HologramCardGrid Name="SpiralGrid" HorizontalExpand="True" Margin="0 0 4 0" />
                            <Label Name="EmptyLabel"
                                   Visible="False"
                                   HorizontalAlignment="Center"
                                   Text="{Loc 'vending-machine-component-try-eject-out-of-stock'}" />
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" SetWidth="240" SeparationOverride="8">
                <PanelContainer Name="DisplayPanel">
                    <BoxContainer Orientation="Vertical" Margin="10 8">
                        <Label Name="CodeCaption"
                               Text="{Loc 'hologram-vending-code-title'}"
                               Visible="False" />
                        <Label Name="CodeDisplay" ClipText="True" />
                        <Label Name="StatusDisplay" ClipText="True" />
                    </BoxContainer>
                </PanelContainer>
                <GridContainer Name="KeypadGrid" Columns="3" HorizontalExpand="True" />
                <BoxContainer Name="BalanceRow" Orientation="Horizontal" Visible="False">
                    <Label Name="BalanceCaption"
                           Text="{Loc 'hologram-vending-balance'}"
                           VerticalAlignment="Center" />
                    <Label Name="BalanceDisplay"
                           HorizontalExpand="True"
                           Align="Right"
                           ClipText="True" />
                </BoxContainer>
                <Button Name="WithdrawButton"
                        Text="{Loc 'vending-machine-keypad-withdraw'}"
                        HorizontalAlignment="Stretch"
                        Visible="False" />
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical" Margin="0 4 0 0">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0">
                <Label Text="{Loc 'vending-machine-flavor-left'}" StyleClasses="WindowFooterText" />
                <Label Text="{Loc 'vending-machine-flavor-right'}" StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right" HorizontalExpand="True" Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                             VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
