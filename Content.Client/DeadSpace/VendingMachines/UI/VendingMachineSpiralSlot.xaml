<PanelContainer xmlns="https://spacestation14.io"
                MouseFilter="Stop">
    <!-- Every line is a single clipped line and the sprite has a fixed size, so all slots are the same height
         and the grid stays even with long names or odd sprites; the full name is in the tooltip. -->
    <BoxContainer Orientation="Vertical" Margin="6 4" SeparationOverride="2">
        <SpriteView Name="ItemPrototype"
                    HorizontalAlignment="Center"
                    Stretch="Fill"
                    SetSize="64 64" />
        <Label Name="NameLabel"
               HorizontalExpand="True"
               Align="Center"
               ClipText="True" />
        <BoxContainer Name="SpiralCoils"
                      Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      SeparationOverride="2"
                      MinHeight="8" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Label Name="AmountLabel"
                   VerticalAlignment="Center"
                   StyleClasses="LabelSubText" />
            <Label Name="PriceLabel"
                   Visible="False"
                   HorizontalExpand="True"
                   VerticalAlignment="Center"
                   ClipText="True" />
            <Control HorizontalExpand="True" />
            <PanelContainer Name="CodeBadge" VerticalAlignment="Center">
                <Label Name="CodeLabel" />
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
