<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'pipe-shuttle-window-title'}"
    MinSize="300 200"
    SetSize="300 200">
    <BoxContainer VerticalExpand="True" Orientation="Vertical" Margin="10">
        <Label Text="{Loc 'pipe-shuttle-window-select-destination'}" StyleClasses="LabelSubText" Margin="0 0 0 5"/>
        <ItemList Name="StopList" VerticalExpand="True" Margin="0 0 0 10"/>
        <Label Name="StatusLabel" Text="{Loc 'pipe-shuttle-status-idle'}" StyleClasses="LabelSubText" Margin="0 0 0 5"/>
        <Button Name="CallButton" Text="{Loc 'pipe-shuttle-window-call'}" HorizontalAlignment="Center" Disabled="True"/>
    </BoxContainer>
</controls:FancyWindow>
