<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.DeadSpace.OrganPrinter.OrganPrinterWindow"
               Title="{Loc organ-printer-title}"
               MinSize="680 560"
               SetSize="850 660">

    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">

        <!-- Основной режим -->
        <BoxContainer Name="MainContainer"
                      Orientation="Horizontal"
                      VerticalExpand="True"
                      HorizontalExpand="True"
                      SeparationOverride="10"
                      Margin="6">

            <!-- Каталог органов -->
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          SizeFlagsStretchRatio="5"
                          SeparationOverride="6">
                <PanelContainer StyleClasses="DeadSpaceSectionHeader">
                    <Label Text="{Loc organ-printer-organs-label}"
                           StyleClasses="DeadSpaceSectionTitle"
                           HorizontalAlignment="Center" />
                </PanelContainer>
                <OptionButton Name="GroupFilter"
                              StyleClasses="DeadSpaceFormField"
                              MinHeight="34" />
                <PanelContainer VerticalExpand="True" StyleClasses="DeadSpaceInset">
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="4">
                        <BoxContainer Name="OrganList"
                                      Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SeparationOverride="3" />
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <!-- Карточка органа и статус -->
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          SizeFlagsStretchRatio="7"
                          SeparationOverride="8">

                <PanelContainer VerticalExpand="True" StyleClasses="DeadSpaceSurfaceDark">
                    <BoxContainer Name="PreviewContainer"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  VerticalExpand="True"
                                  SeparationOverride="8"
                                  Margin="12">
                        <PanelContainer MinSize="200 200"
                                        MaxSize="200 200"
                                        RectClipContent="True"
                                        HorizontalAlignment="Center"
                                        StyleClasses="DeadSpaceInset">
                            <EntityPrototypeView Name="PreviewSprite"
                                                 Scale="6 6"
                                                 HorizontalExpand="True"
                                                 VerticalExpand="True" />
                        </PanelContainer>
                        <Label Name="PreviewNameLabel"
                               StyleClasses="DeadSpaceTitle"
                               HorizontalAlignment="Center" />
                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                            <RichTextLabel Name="PreviewDescLabel" StyleClasses="LabelSubText" />
                        </ScrollContainer>
                        <Label Name="PreviewHintLabel"
                               Text="{Loc organ-printer-select-hint}"
                               HorizontalAlignment="Center"
                               StyleClasses="LabelSubText" />
                    </BoxContainer>
                </PanelContainer>

                <PanelContainer StyleClasses="DeadSpaceInset">
                    <BoxContainer Orientation="Horizontal"
                                  Margin="10 6 10 6"
                                  SeparationOverride="12">
                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalAlignment="Center"
                                      SeparationOverride="3">
                            <Label Text="{Loc organ-printer-biomass-title}" StyleClasses="LabelSubText" />
                            <Label Name="BiomassLabel" />
                            <Label Name="CostLabel" />
                        </BoxContainer>
                        <Button Name="PrintButton"
                                Text="{Loc organ-printer-print-button}"
                                StyleClasses="ButtonBig"
                                MinWidth="170"
                                VerticalAlignment="Center"
                                Disabled="True" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>

        <!-- Оверлей мини-игры «Сплайсинг ткани» -->
        <BoxContainer Name="GameOverlay"
                      Orientation="Vertical"
                      Visible="False"
                      VerticalExpand="True"
                      HorizontalExpand="True"
                      SeparationOverride="4"
                      Margin="4">

            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                <Label Name="GameTitleLabel"
                       Text="{Loc organ-printer-game-splicing}"
                       StyleClasses="LabelBig"
                       HorizontalExpand="True" />
                <Label Name="GameCoverageLabel" StyleClasses="LabelSubText" MinWidth="130" />
                <Label Name="GameWasteLabel" StyleClasses="LabelSubText" MinWidth="130" />
                <Label Name="GameIntegrityLabel" StyleClasses="LabelSubText" MinWidth="130" />
            </BoxContainer>

            <Label Name="GameResultLabel"
                   HorizontalAlignment="Center"
                   StyleClasses="LabelBig"
                   Visible="False" />

            <PanelContainer VerticalExpand="True" StyleClasses="DeadSpaceSurfaceDark">
                <BoxContainer Name="GameCanvasContainer"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              VerticalExpand="True" />
            </PanelContainer>

            <Label Name="GameModeHintLabel"
                   Text="{Loc organ-printer-game-goal}"
                   HorizontalAlignment="Center"
                   StyleClasses="LabelSubText" />

            <BoxContainer Orientation="Horizontal" SeparationOverride="8" Align="Center">
                <Button Name="GameFastButton"
                        Text="{Loc organ-printer-game-fast}"
                        ToolTip="{Loc organ-printer-game-fast-desc}"
                        StyleClasses="ButtonBig"
                        MinWidth="160" />
                <Button Name="GameFineButton"
                        Text="{Loc organ-printer-game-fine}"
                        ToolTip="{Loc organ-printer-game-fine-desc}"
                        StyleClasses="ButtonBig"
                        MinWidth="160" />
                <Button Name="GameAbortButton"
                        Text="{Loc organ-printer-game-abort}"
                        MinWidth="100" />
                <Button Name="GameDoneButton"
                        Text="{Loc organ-printer-game-done}"
                        StyleClasses="ButtonBig"
                        MinWidth="100"
                        Visible="False" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
