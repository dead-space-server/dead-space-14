<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'medical-records-console-window-title'}"
                       MinSize="1080 640">
    <BoxContainer Orientation="Vertical" Margin="8">
        <!-- Record search bar -->
        <BoxContainer Margin="5 5 5 10"
                      HorizontalExpand="True"
                      VerticalAlignment="Center">
            <OptionButton Name="FilterType"
                          MinWidth="220"
                          Margin="0 0 10 0" />
            <LineEdit Name="FilterText"
                      PlaceHolder="{Loc 'medical-records-filter-placeholder'}"
                      HorizontalExpand="True" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" VerticalExpand="True">
            <!-- Record listing -->
            <BoxContainer Orientation="Vertical"
                          Margin="10 10"
                          MinWidth="230"
                          MaxWidth="230">
                <Label Name="RecordListingTitle"
                       Text="{Loc 'medical-records-console-records-list-title'}"
                       HorizontalExpand="True"
                       Align="Center" />
                <Label Name="NoRecords"
                       Text="{Loc 'medical-records-console-no-records'}"
                       HorizontalExpand="True"
                       Align="Center"
                       StyleClasses="DeadSpaceSubtitle" />
                <ScrollContainer VerticalExpand="True">
                    <ItemList Name="RecordListing" />
                </ScrollContainer>
            </BoxContainer>

            <Label Name="RecordUnselected"
                   Text="{Loc 'medical-records-console-select-record-info'}"
                   HorizontalExpand="True"
                   Align="Center"
                   StyleClasses="DeadSpaceSubtitle" />

            <!-- Selected patient card -->
            <BoxContainer Name="PatientContainer"
                          Orientation="Vertical"
                          VerticalExpand="True"
                          HorizontalExpand="True"
                          Margin="5"
                          Visible="False">
                <!-- Identity block, read-only, sourced from the general record -->
                <Label Name="PatientName" StyleClasses="LabelBig" />
                <BoxContainer Orientation="Horizontal" Margin="0 0 0 5">
                    <Label Text="{Loc 'crew-monitoring-ui-job-label'}" StyleClasses="DeadSpaceSubtitle" />
                    <TextureRect Name="PatientJobIcon"
                                 TextureScale="2 2"
                                 Margin="6 0"
                                 VerticalAlignment="Center" />
                    <Label Name="PatientJob" />
                </BoxContainer>
                <Label Name="PatientAge" StyleClasses="DeadSpaceSubtitle" />
                <Label Name="PatientSpecies" StyleClasses="DeadSpaceSubtitle" />

                <PanelContainer StyleClasses="LowDivider" Margin="0 5 0 5" />

                <!-- Medical specifics, sourced from the medical record -->
                <Label Name="PatientSex" StyleClasses="DeadSpaceSubtitle" />
                <Label Name="PatientDna" StyleClasses="DeadSpaceSubtitle" />

                <BoxContainer Orientation="Horizontal" Margin="0 5 0 5">
                    <Label Text="{Loc 'medical-records-console-status'}" StyleClasses="DeadSpaceSubtitle" />
                    <Label Text=":" Margin="0 0 6 0" StyleClasses="DeadSpaceSubtitle" />
                    <Label Name="PatientStatus" />
                </BoxContainer>

                <BoxContainer Orientation="Horizontal" Margin="0 5 0 5">
                    <Button Name="StatusNoneButton"
                            Text="{Loc 'medical-records-status-none'}" />
                    <Button Name="StatusOnTreatmentButton"
                            Text="{Loc 'medical-records-status-ontreatment'}"
                            Margin="6 0 0 0" />
                    <Button Name="StatusPsychButton"
                            Text="{Loc 'medical-records-status-psychunstable'}"
                            Margin="6 0 0 0" />
                    <Button Name="StatusCompletedButton"
                            Text="{Loc 'medical-records-status-completedtreatment'}"
                            Margin="6 0 0 0" />
                </BoxContainer>

                <PanelContainer StyleClasses="LowDivider" Margin="0 5 0 5" />

                <!-- History -->
                <Label Name="HistoryTitle"
                       Text="{Loc 'medical-records-console-history-title'}"
                       StyleClasses="DeadSpaceSubtitle"
                       HorizontalExpand="True" />
                <Label Name="NoHistory"
                       Text="{Loc 'medical-records-console-no-history'}"
                       HorizontalExpand="True"
                       Align="Center"
                       StyleClasses="DeadSpaceSubtitle" />
                <ScrollContainer VerticalExpand="True">
                    <ItemList Name="History" />
                </ScrollContainer>
                <RichTextLabel Name="CaseDetails"
                               Visible="False"
                               MaxWidth="700"
                               Margin="0 5 0 0" />

                <BoxContainer Orientation="Horizontal" Margin="0 5 0 0">
                    <Button Name="AddCaseButton" Text="{Loc 'medical-records-console-add-case'}" />
                    <Button Name="EditCaseButton"
                            Text="{Loc 'medical-records-console-edit-case'}"
                            Margin="6 0 0 0" />
                    <Button Name="DeleteCaseButton"
                            Text="{Loc 'medical-records-console-delete-case'}"
                            Margin="6 0 0 0" />
                    <Button Name="PrintCaseButton"
                            Text="{Loc 'medical-records-console-print-case'}"
                            Margin="6 0 0 0" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" Margin="0 0 0 5">
            <OptionButton Name="CrewListFilter"
                          MinWidth="220"
                          Margin="10 0 10 0" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
