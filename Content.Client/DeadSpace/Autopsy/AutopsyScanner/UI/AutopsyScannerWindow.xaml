<DefaultWindow xmlns="https://spacestation14.io"
    SetSize="250 100">
    <ScrollContainer
        VerticalExpand="True">
        <BoxContainer
            Name="RootContainer"
            Orientation="Vertical">
            <Label
                Name="NoPatientDataText"
                Text="{Loc autopsy-scanner-window-no-patient-data-text}" />
            <BoxContainer
                Name="PatientDataContainer"
                Orientation="Vertical"
                Margin="0 0 5 10">
                <Label
                    Name="PatientName"/>
                <Label
                    Name="IdentityText"
                    Margin="0 5 0 0"/>
            </BoxContainer>
            <BoxContainer
                Name="OrgansContainer"
                Orientation="Vertical">
            </BoxContainer>
        </BoxContainer>
    </ScrollContainer>
</DefaultWindow>
