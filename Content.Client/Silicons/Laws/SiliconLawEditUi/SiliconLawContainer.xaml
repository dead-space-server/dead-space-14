<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Vertical">
    <controls:Separator StyleClasses="LowDivider"/>
    <BoxContainer>
        <BoxContainer
            Orientation="Vertical"
            VerticalAlignment="Center"
            Margin="0 0 5 0">
            <Button
                Name="MoveUp"
                Text="{Loc silicon-law-ui-minus-one}"
                StyleClasses="OpenLeft">
            </Button>
            <Label
                StyleClasses="SiliconLawPositionLabel"
                Name="PositionText"
                Align="Center">
            </Label>
            <Button
                Name="MoveDown"
                Text="{Loc silicon-law-ui-plus-one}"
                StyleClasses="OpenRight">
            </Button>
        </BoxContainer>
        <!-- DS14-start -->
        <PanelContainer StyleClasses="DeadSpaceInset"
            Margin="0 10 10 0"
            MinHeight="128"
            HorizontalExpand="True">
            <BoxContainer
                Orientation="Horizontal"
                SeparationOverride="5">
                <TextEdit
                    Name="LawContent"
                    HorizontalExpand="True"
                    Editable="True"
                    MinHeight="80">
                </TextEdit>
            </BoxContainer>
        </PanelContainer>
        <!-- DS14-end -->
    </BoxContainer>
    <BoxContainer
        Orientation="Horizontal"
        Margin="5 10 5 10">
        <CheckBox
            Name="Corrupted"
            Text="{Loc silicon-law-ui-check-corrupted}"
            ToolTip="{Loc silicon-law-ui-check-corrupted-tooltip}">
        </CheckBox>
        <BoxContainer
            HorizontalExpand="True"> <!--> This is here just to seperate the two buttons on the UI. I hate this. <!-->
        </BoxContainer>
        <Button
            Name="Delete"
            Text="{Loc silicon-law-ui-delete}"
            StyleClasses="DeadSpaceControlDanger"
            Margin="5 0 0 0"> <!-- DS14 -->
        </Button>
    </BoxContainer>
</BoxContainer>
