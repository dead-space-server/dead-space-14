<DefaultWindow xmlns="https://spacestation14.io"
            Title="{Loc 'crayon-window-title'}"
            MinSize="450 500"
            SetSize="450 500">
    <BoxContainer Orientation="Vertical">
        <ColorSelectorSliders Name="ColorSelector" Visible="False" />
        <LineEdit Name="Search" Margin="0 0 0 8" PlaceHolder="{Loc 'crayon-window-placeholder'}" />
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Name="Grids" Orientation="Vertical">
            </BoxContainer>
        </ScrollContainer>
		<!-- DS-14 Start -->
		<BoxContainer Orientation="Horizontal" Margin="0 8 0 4">
			<Label Text="{Loc 'crayon-opacity-verb'}" Margin="0 0 8 0" VerticalAlignment="Center"/>
			<Slider Name="OpacitySlider" MinValue="10" MaxValue="100" HorizontalExpand="True" Rounded="True"/>
			<Label Name="PercentLabel" Text="100%" MinWidth="44" Margin="8 0 0 0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
		</BoxContainer>
		<BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
			<Label Text="Поворот:" Margin="0 0 8 0" VerticalAlignment="Center"/>
			<LineEdit Name="RotationInput" Text="0" HorizontalExpand="True"/>
		</BoxContainer>
		<!-- DS-14 End-->
    </BoxContainer>
</DefaultWindow>
