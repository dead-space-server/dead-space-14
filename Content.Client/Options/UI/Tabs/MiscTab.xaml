<tabs:MiscTab xmlns="https://spacestation14.io"
              xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8" VerticalExpand="True">
                <!-- DS14-start -->
                <Label Text="{Loc 'ui-options-general-ui-style'}"
                       StyleClasses="DeadSpaceSectionTitle"/>
                <ui:OptionDropDown Name="DropDownInterfaceStyle" Title="{Loc 'ui-options-interface-style'}" />
                <!-- DS14-end -->
                <ui:OptionDropDown Name="DropDownHudTheme" Title="{Loc 'ui-options-hud-theme'}" />
                <ui:OptionDropDown Name="DropDownHudLayout" Title="{Loc 'ui-options-hud-layout'}" />
                <ui:OptionDropDown Name="BackgroundHudLayout" Title="{Loc 'ui-options-background-hud-layout'}" />
                <!-- DS14-start -->
                <Label Text="{Loc 'ui-options-general-hologram'}"
                       StyleClasses="DeadSpaceSectionTitle"/>
                <ui:OptionColorSlider Name="HologramColorSlider"
                                      Title="{Loc 'ui-options-hologram-color'}"
                                      Example="{Loc 'ui-options-hologram-color-example'}"/>
                <ui:OptionSlider Name="HologramOpacitySlider" Title="{Loc 'ui-options-hologram-opacity'}" />
                <CheckBox Name="HologramCompactCheckBox" Text="{Loc 'ui-options-hologram-compact'}" />
                <ui:OptionSlider Name="HologramEffectsSlider" Title="{Loc 'ui-options-hologram-effects'}" />
                <ui:OptionSlider Name="HologramOpenTimeSlider" Title="{Loc 'ui-options-hologram-open-time'}" />
                <ui:OptionSlider Name="HologramCloseTimeSlider" Title="{Loc 'ui-options-hologram-close-time'}" />
                <CheckBox Name="HologramScanlineCheckBox" Text="{Loc 'ui-options-hologram-scanline'}" />
                <CheckBox Name="HologramFlickerCheckBox" Text="{Loc 'ui-options-hologram-flicker'}" />
                <CheckBox Name="HologramSoundsCheckBox" Text="{Loc 'ui-options-hologram-sounds'}" />
                <CheckBox Name="HologramCursorCheckBox" Text="{Loc 'ui-options-hologram-cursor'}" />
                <ui:OptionSlider Name="HologramCursorScaleSlider" Title="{Loc 'ui-options-hologram-cursor-scale'}" />
                <CheckBox Name="HologramChatFrameCheckBox" Text="{Loc 'ui-options-hologram-chat-frame'}" />
                <CheckBox Name="HologramLobbyCabinCheckBox" Text="{Loc 'ui-options-hologram-lobby-cabin'}" />
                <Button Name="HologramResetButton" Text="{Loc 'ui-options-hologram-reset'}" HorizontalAlignment="Left" Margin="0 4 0 0" />
                <!-- DS14-end -->
                <!-- DS14-start -->
                <Label Text="{Loc 'ui-options-general-discord'}"
                       StyleClasses="DeadSpaceSectionTitle"/>
                <!-- DS14-end -->
                <CheckBox Name="DiscordRich" Text="{Loc 'ui-options-discordrich'}" />
                <!-- DS14-start -->
                <Label Text="{Loc 'ui-options-general-speech'}"
                       StyleClasses="DeadSpaceSectionTitle"/>
                <!-- DS14-end -->
                <CheckBox Name="ShowOocPatronColor" Text="{Loc 'ui-options-show-ooc-patron-color'}" />
                <CheckBox Name="ShowLoocAboveHeadCheckBox" Text="{Loc 'ui-options-show-looc-on-head'}" />
                <CheckBox Name="FancySpeechBubblesCheckBox" Text="{Loc 'ui-options-fancy-speech'}" />
                <CheckBox Name="FancyNameBackgroundsCheckBox" Text="{Loc 'ui-options-fancy-name-background'}" />
                <CheckBox Name="PointingBubblesCheckBox" Text="{Loc 'ui-options-pointing-bubbles'}" /> <!--DS14-->
                <CheckBox Name="PopOutChat" Text="{Loc 'ui-options-fancy-name-pop-out-chat'}" ToolTip="!!!ВНИМАНИЕ РАБОТАЕТ ТОЛЬКО ПОСЛЕ ПЕРЕЗАГРУЗКИ ИГРЫ!!!" /> <!--DS14-->
                <!-- DS14-start -->
                <Label Text="{Loc 'ui-options-general-cursor'}"
                       StyleClasses="DeadSpaceSectionTitle"/>
                <!-- DS14-end -->
                <CheckBox Name="ShowHeldItemCheckBox" Text="{Loc 'ui-options-show-held-item'}" />
                <CheckBox Name="ShowCombatModeIndicatorsCheckBox" Text="{Loc 'ui-options-show-combat-mode-indicators'}" />
                <!-- DS14-start -->
                <Label Text="{Loc 'ui-options-general-storage'}"
                       StyleClasses="DeadSpaceSectionTitle"/>
                <!-- DS14-end -->
                <CheckBox Name="OpaqueStorageWindowCheckBox" Text="{Loc 'ui-options-opaque-storage-window'}" />
                <CheckBox Name="StaticStorageUI" Text="{Loc 'ui-options-static-storage-ui'}" />
                <CheckBox Name="MultipleInventoryWindowsCheckBox" Text="{Loc 'ui-options-multiple-inventory-windows'}" /><!--DS14-->
                <CheckBox Name="ActionsRestoreItemSlotsCheckBox" Text="{Loc 'ui-options-actions-restore-item-slots'}" /><!--DS14-->
                <CheckBox Name="GunAmmoModeActionCheckBox" Text="{Loc 'ui-options-gun-ammo-mode-action'}" /><!--DS14-->
                <!-- <CheckBox Name="ToggleWalk" Text="{Loc 'ui-options-hotkey-toggle-walk'}" /> -->
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:MiscTab>
