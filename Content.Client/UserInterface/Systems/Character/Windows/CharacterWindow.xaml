<windows:CharacterWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:windows="clr-namespace:Content.Client.UserInterface.Systems.Character.Windows"
    xmlns:medical="clr-namespace:Content.Client.DeadSpace.UserInterface.Hologram.Medical"
    Title="{Loc 'character-info-title'}"
    MinWidth="680"
    MinHeight="380">
    <!-- DS14-start -->
    <ScrollContainer HScrollEnabled="False">
        <BoxContainer Orientation="Horizontal" SeparationOverride="22" Margin="4 4 4 4">
            <!-- Character card: portrait, name, job and department, role type. -->
            <BoxContainer Orientation="Vertical" MinWidth="230" SeparationOverride="4">
                <PanelContainer Name="PortraitFrame" SetSize="220 220" HorizontalAlignment="Center">
                    <SpriteView OverrideDirection="South" Scale="6 6" Name="SpriteView" Access="Public" SetSize="192 192" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </PanelContainer>
                <Label Name="NameLabel" Access="Public" HorizontalAlignment="Center" StyleClasses="DeadSpaceTitle" Margin="0 8 0 0"/>
                <Label Name="SubText" Access="Public" HorizontalAlignment="Center" StyleClasses="DeadSpaceSubtitle"/>
                <Label Name="RoleType" Access="Public" HorizontalAlignment="Center" StyleClasses="DeadSpaceSectionTitle" Margin="0 6 0 0"/>
            </BoxContainer>

            <!-- Objectives, then memory. -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                <medical:HoloSectionHeader Name="ObjectivesLabel" Access="Public" Text="{Loc 'character-info-objectives-label'}"/>
                <BoxContainer Orientation="Vertical" Name="Objectives" Access="Public" SeparationOverride="4"/>
                <cc:Placeholder Name="RolePlaceholder" Access="Public" PlaceholderText="{Loc 'character-info-roles-antagonist-text'}"/>
                <BoxContainer Name="MemorySection" Access="Public" Orientation="Vertical" Visible="False" Margin="0 8 0 0">
                    <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 6"/>
                    <Label Name="MemoryLabel" StyleClasses="DeadSpaceSubtitle"/>
                    <BoxContainer Orientation="Vertical" Name="Memory" Access="Public"/> <!-- backmen: currency -->
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </ScrollContainer>
    <!-- DS14-end -->
</windows:CharacterWindow>
