<controls:FancyWindow xmlns="https://spacestation14.io" xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinWidth="480">
    <BoxContainer Orientation="Vertical" Margin="8">
        <BoxContainer Name="Prompts" Orientation="Vertical"/> <!-- Populated in constructor -->
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 8 0 0">
            <Button Name="OkButton" Text="{Loc 'quick-dialog-ui-ok'}" MinWidth="75" Margin="0 0 8 0"/>
            <Button Name="CancelButton" Text="{Loc 'quick-dialog-ui-cancel'}" MinWidth="75"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
