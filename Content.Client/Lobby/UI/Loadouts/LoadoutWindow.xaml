<controls:FancyWindow xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         SetSize="800 800"
         MinSize="800 128">
    <BoxContainer Orientation="Vertical" VerticalExpand="True">
        <BoxContainer Name="RoleNameBox" Orientation="Vertical" Margin="10">
            <!-- DS14-start -->
            <Label Name="LoadoutNameLabel" StyleClasses="DeadSpaceSectionTitle"/>
            <LineEdit Name="RoleNameEdit" VerticalExpand="True" HorizontalExpand="True" Margin="6"/>
            <!-- DS14-end -->
        </BoxContainer>
        <VerticalTabContainer Name="LoadoutGroupsContainer"
                              VerticalExpand="True"
                              HorizontalExpand="True">
        </VerticalTabContainer>
    </BoxContainer>
</controls:FancyWindow>
