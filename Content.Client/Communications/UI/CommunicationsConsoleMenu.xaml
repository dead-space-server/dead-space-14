<!-- DS14-start -->
<comms:CommunicationsConsoleMenu xmlns="https://spacestation14.io"
    xmlns:comms="clr-namespace:Content.Client.Communications.UI"
    xmlns:widgets="clr-namespace:Content.Client.Communications.UI.Widgets"
    MinSize="380 360" SetSize="450 460" Resizable="True"
    Title="{Loc 'comms-console-menu-title'}">
    <!-- DS14-end -->
    <!-- DS14-start -->
    <ScrollContainer HScrollEnabled="False" VerticalExpand="True" ReserveScrollbarSpace="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8" SeparationOverride="10">
            <widgets:MessagingControls Name="MessagingControls" MinHeight="300" VerticalExpand="True" />

            <Button Name="EmagChannelButton"
                Access="Public"
                Text="{Loc 'emag-comms-switch-emag'}"
                Visible="False" />

            <widgets:AlertLevelControls Name="AlertLevelControls" Margin="0 4" />
            <widgets:ShuttleControls Name="ShuttleControls" Margin="0 4" />
        </BoxContainer>
    </ScrollContainer>
    <!-- DS14-end -->
</comms:CommunicationsConsoleMenu>
