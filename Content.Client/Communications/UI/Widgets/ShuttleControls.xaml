<Control xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Controls for calling, recalling and displaying info for the emergency shuttle -->
    <!-- DS14-start: one row, status on the left and the buttons on the right -->
    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
            <Label StyleClasses="DeadSpaceSectionTitle"
                Text="{Loc 'comms-console-shuttle-controls-header'}" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="ShuttleStatusLabel" StyleClasses="monospace" />
                <Label StyleClasses="DeadSpaceSubtitle" VerticalAlignment="Center"
                    Text="{Loc 'comms-console-shuttle-status-label'}" />
                <Label Name="CountdownLabel" ReservesSpace="True" StyleClasses="monospace" />
            </BoxContainer>
        </BoxContainer>
        <Button Name="EmergencyShuttleCallButton" VerticalAlignment="Center"
            StyleClasses="DeadSpaceControlWarning"
            Text="{Loc 'comms-console-call-button-label'}" />
        <Button Name="EmergencyShuttleRecallButton" VerticalAlignment="Center"
            Text="{Loc 'comms-console-recall-button-label'}" />
    </BoxContainer>
    <!-- DS14-end -->
</Control>
